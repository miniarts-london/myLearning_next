# Your Moodle site, without a trailing slash.
MOODLE_URL=http://localhost:8080

# The Moodle external service users log in through. moodle_mobile_app is built in;
# turn it on under Site administration > Advanced features > Enable web services for mobile devices.
MOODLE_SERVICE=moodle_mobile_app

# A random secret of at least 32 characters, used to encrypt the session cookie.
# Make one with: openssl rand -base64 32
SESSION_SECRET=

# "Ask this course" (optional): the Python service in ai-service/. Leave empty to hide the feature.
# AI_SERVICE_TOKEN must match the one in ai-service/.env.
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=
