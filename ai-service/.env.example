# Copy to .env and fill in. Never commit .env.

# Shared secret between the Next.js app and this service. Use the same value as
# AI_SERVICE_TOKEN in the Next.js .env.local. Make one with: openssl rand -base64 32
AI_SERVICE_TOKEN=

# Your Claude API key from https://platform.claude.com (Settings > API keys).
# Leave empty for demo mode: the service then shows the most relevant course extracts
# instead of writing an answer, so everything else can be tried without a key.
ANTHROPIC_API_KEY=

# claude-haiku-5-5 is the fastest and cheapest; claude-sonnet-5-5 writes better answers.
CLAUDE_MODEL=claude-haiku-5-5

# Questions each learner may ask per day (resets at midnight UTC).
DAILY_QUESTION_LIMIT=20

# Where the search index is stored.
CHROMA_PATH=./data/chroma

# "default": a small embedding model that runs locally (downloaded on first use, about 80 MB).
# "hash": a simple offline stand-in, used by the tests. Fine for trying things, worse at finding answers.
EMBEDDINGS=default

# How similar (0–1) a course extract must be to the question to be used. Lower finds more but
# risks off-topic extracts; the service log shows the best similarity for each question.
MIN_SIMILARITY=0.2
